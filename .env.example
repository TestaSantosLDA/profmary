# Supabase — from your project's API settings (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Service role key — server-only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Booking window: how many months ahead students can request lessons
BOOKING_WINDOW_MONTHS=3

# Resend — transactional email (https://resend.com/api-keys)
RESEND_API_KEY=<resend-api-key>
# Sender address; use onboarding@resend.dev until the domain is verified
EMAIL_FROM="ProfMary <onboarding@resend.dev>"

# Secret shared with the GitHub Actions cron workflow (any long random string)
CRON_SECRET=<random-string>

# Google Calendar sync (Google Cloud Console > Credentials > OAuth client)
GOOGLE_CLIENT_ID=<oauth-client-id>
GOOGLE_CLIENT_SECRET=<oauth-client-secret>

# Absolute base URL of the deployed site (used in emails and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
